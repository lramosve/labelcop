# Choose the LLM backend used for label verification: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic (only required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Optional: override the default Anthropic model
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI (only required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Optional: override the default OpenAI model (alias or dated snapshot)
OPENAI_MODEL=gpt-5.5
