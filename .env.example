# Choose the LLM backend used for label verification: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI (required when LLM_PROVIDER=openai — this is the default)
OPENAI_API_KEY=
# Optional: override the default OpenAI model (alias or dated snapshot)
OPENAI_MODEL=gpt-5.4-mini

# Anthropic (only required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Optional: override the default Anthropic model
ANTHROPIC_MODEL=claude-sonnet-4-6
